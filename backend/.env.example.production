# =====================================================================
# Production environment template for the Portfolio CMS backend.
# Copy to `.env` on the server and fill in the secrets. See README
# "Production checklist" before deploying. Do NOT commit the real .env.
# =====================================================================

APP_NAME="Portfolio CMS"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --force (BACK THIS UP)
APP_DEBUG=false
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Keep logs quiet in production; avoid leaking detail at debug level.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database (use real credentials; never commit them).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=portfolio_cms
DB_USERNAME=portfolio
DB_PASSWORD=

# Prefer non-default stores in production.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail (real SMTP/credentials).
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CORS: restrict to the real admin origin(s) only.
CORS_ALLOWED_ORIGINS=https://admin.example.com

# Contact notifications.
WEB3FORMS_ACCESS_KEY=
MAIL_TO_ADDRESS=owner@example.com

# Admin API tokens expire after 8 hours by default.
SANCTUM_TOKEN_EXPIRATION=480

# Initial admin account (REQUIRED before seeding; no default password).
ADMIN_NAME="Site Owner"
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=

# Trusted reverse-proxy/load-balancer IP(s) so rate limiting sees real client IPs.
TRUSTED_PROXIES=

# PII payload encryption key shared with the admin frontend (BACK THIS UP).
PAYLOAD_ENCRYPTION_KEY=
