# SPA (React Router) fallback + sane caching for the admin build.
# Placed in admin/public/ so Vite copies it into dist/ on every build.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Serve the real file if it exists (assets, favicon, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise hand every route to the SPA entry point.
    RewriteRule ^ index.html [L]
</IfModule>

# Gzip text assets.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Hashed build assets are immutable -> cache them for a year.
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Never cache the HTML entry so new deploys are picked up immediately.
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
